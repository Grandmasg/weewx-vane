#errorCatcher Echo
#encoding UTF-8
#*
  One JSON file per month that actually exists in the archive data — WeeWX's
  SummaryByMonth generator iterates this automatically (same mechanism as
  NOAA/NOAA-%Y-%m.txt.tmpl). $month here is "the month currently being
  generated", not necessarily the current month.
*#
{
  "period": "archive-month",
  "temp": $month.outTemp.series(aggregate_type='avg', aggregate_interval=3600, time_series='start').json(order_by='column'),
  "dewpoint": $month.dewpoint.series(aggregate_type='avg', aggregate_interval=3600, time_series='start').json(order_by='column'),
  "barometer": $month.barometer.series(aggregate_type='avg', aggregate_interval=3600, time_series='start').json(order_by='column'),
  "windSpeed": $month.windSpeed.series(aggregate_type='avg', aggregate_interval=3600, time_series='start').json(order_by='column'),
  "windGust": $month.windGust.series(aggregate_type='max', aggregate_interval=3600, time_series='start').json(order_by='column'),
  "rain": $month.rain.series(aggregate_type='sum', aggregate_interval=3600, time_series='start').json(order_by='column'),
  "humidity": $month.outHumidity.series(aggregate_type='avg', aggregate_interval=3600, time_series='start').json(order_by='column'),
  "uv": $month.UV.series(aggregate_type='avg', aggregate_interval=3600, time_series='start').json(order_by='column'),
  "radiation": $month.radiation.series(aggregate_type='avg', aggregate_interval=3600, time_series='start').json(order_by='column'),
  "cloudbase": $month.cloudbase.series(aggregate_type='avg', aggregate_interval=3600, time_series='start').json(order_by='column'),
  "et": $month.ET.series(aggregate_type='sum', aggregate_interval=3600, time_series='start').json(order_by='column')
}
