#errorCatcher Echo
#encoding UTF-8
{
  "period": "week",
  "generated": $current.dateTime.raw,
  "temp": $week.outTemp.series(aggregate_type='avg', aggregate_interval=3600, time_series='start').json(order_by='column'),
  "dewpoint": $week.dewpoint.series(aggregate_type='avg', aggregate_interval=3600, time_series='start').json(order_by='column'),
  "barometer": $week.barometer.series(aggregate_type='avg', aggregate_interval=3600, time_series='start').json(order_by='column'),
  "windSpeed": $week.windSpeed.series(aggregate_type='avg', aggregate_interval=3600, time_series='start').json(order_by='column'),
  "windGust": $week.windGust.series(aggregate_type='max', aggregate_interval=3600, time_series='start').json(order_by='column'),
  "rain": $week.rain.series(aggregate_type='sum', aggregate_interval=3600, time_series='start').json(order_by='column'),
  "humidity": $week.outHumidity.series(aggregate_type='avg', aggregate_interval=3600, time_series='start').json(order_by='column'),
  "uv": $week.UV.series(aggregate_type='avg', aggregate_interval=3600, time_series='start').json(order_by='column'),
  "radiation": $week.radiation.series(aggregate_type='avg', aggregate_interval=3600, time_series='start').json(order_by='column'),
  "cloudbase": $week.cloudbase.series(aggregate_type='avg', aggregate_interval=3600, time_series='start').json(order_by='column'),
  "et": $week.ET.series(aggregate_type='sum', aggregate_interval=3600, time_series='start').json(order_by='column')
}
