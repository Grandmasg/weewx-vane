#errorCatcher Echo
#encoding UTF-8
#*
  TODO: switch to aggregate_interval=week instead of day once there's >5
  years of history, to keep the JSON compact (see docs/THEME_PLAN.md
  downsampling strategy) — fixed at day aggregation for v1.
*#
{
  "period": "all",
  "generated": $current.dateTime.raw,
  "temp": $alltime.outTemp.series(aggregate_type='avg', aggregate_interval=86400, time_series='start').json(order_by='column'),
  "dewpoint": $alltime.dewpoint.series(aggregate_type='avg', aggregate_interval=86400, time_series='start').json(order_by='column'),
  "barometer": $alltime.barometer.series(aggregate_type='avg', aggregate_interval=86400, time_series='start').json(order_by='column'),
  "windSpeed": $alltime.windSpeed.series(aggregate_type='avg', aggregate_interval=86400, time_series='start').json(order_by='column'),
  "windGust": $alltime.windGust.series(aggregate_type='max', aggregate_interval=86400, time_series='start').json(order_by='column'),
  "rain": $alltime.rain.series(aggregate_type='sum', aggregate_interval=86400, time_series='start').json(order_by='column'),
  "humidity": $alltime.outHumidity.series(aggregate_type='avg', aggregate_interval=86400, time_series='start').json(order_by='column'),
  "uv": $alltime.UV.series(aggregate_type='avg', aggregate_interval=86400, time_series='start').json(order_by='column'),
  "radiation": $alltime.radiation.series(aggregate_type='avg', aggregate_interval=86400, time_series='start').json(order_by='column'),
  "cloudbase": $alltime.cloudbase.series(aggregate_type='avg', aggregate_interval=86400, time_series='start').json(order_by='column'),
  "et": $alltime.ET.series(aggregate_type='sum', aggregate_interval=86400, time_series='start').json(order_by='column')
}
