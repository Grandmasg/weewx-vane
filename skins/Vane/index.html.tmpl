#encoding UTF-8
#errorCatcher Echo
<!DOCTYPE html>
<html lang="$lang" data-theme="">
<head>
<script>(function(){try{var t=localStorage.getItem("vane-theme");if(t==="light"||t==="dark")document.documentElement.setAttribute("data-theme",t);}catch(e){}})();</script>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>$station.location — Vane</title>
<meta name="description" content="$station.location — $gettext('Live weather conditions, statistics and sensor data.')">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@300..700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="static/css/vane.css?v=$vane_version">
<link rel="icon" href="favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#020617">
</head>
<body>
<div class="vane-shell">

  <nav class="vane-sidebar" aria-label="$gettext('Navigation')">
    <img class="logo" src="static/img/logo-mark.svg" width="40" height="40" alt="Vane">
    <button class="nav-btn active" title="$gettext('Dashboard')" aria-current="page">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1.5"></rect><rect x="14" y="3" width="7" height="5" rx="1.5"></rect><rect x="14" y="12" width="7" height="9" rx="1.5"></rect><rect x="3" y="16" width="7" height="5" rx="1.5"></rect></svg>
      <span>$gettext("Dashboard")</span>
    </button>
    <a class="nav-btn" href="graphs.html" title="$gettext('Graphs')">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3v18h18"></path><path d="m19 9-5 5-4-4-3 3"></path></svg>
      <span>$gettext("Graphs")</span>
    </a>
    <a class="nav-btn" href="archive.html" title="$gettext('Archive')">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect width="20" height="5" x="2" y="3" rx="1"></rect><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"></path><path d="M10 12h4"></path></svg>
      <span>$gettext("Archive")</span>
    </a>
    <a class="nav-btn" href="telemetry.html" title="$gettext('Telemetry')">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
      <span>$gettext("Telemetry")</span>
    </a>
    <a class="nav-btn" href="almanac.html" title="$gettext('Almanac')">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
      <span>$gettext("Almanac")</span>
    </a>
  </nav>

  <div class="vane-main">
    <div class="vane-content">
      <div class="vane-container">

        <header class="vane-header">
          <div>
            <h1>$station.location</h1>
            <span class="subtitle">$station.latitude[0]&deg;$station.latitude[1]' $station.latitude[2] $station.longitude[0]&deg;$station.longitude[1]' $station.longitude[2] &middot; $station.altitude.format(add_label=True)</span>
          </div>
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
            <div class="pill">
              <span class="live-dot"></span>
              <span style="color:var(--status-live)">$gettext("Live")</span>
              <span style="color:var(--text-muted)">$current.dateTime.format("%H:%M")</span>
            </div>
            #*
              Custom listbox language switcher (WAI-ARIA select-only
              combobox pattern, see lang-select.js) — not a native <select>,
              because a native <select>'s <option> can't contain an <img>
              and this needs real SVG flag icons (FLAG_CODES in
              vane_extras.py). lang-select.js reimplements the keyboard/ARIA
              behavior a native select gives for free. Native names
              ("Nederlands"/"English"), not codes, per language selector UX
              best practice. Each language is a real separate generated page
              (see THEME_PLAN.md i18n section).
            *#
            #set $cur_flag = $vane_language_flag($lang)
            <div class="lang-combo">
              <button type="button" class="lang-trigger" aria-haspopup="listbox" aria-expanded="false" title="$gettext('Switch language')" aria-label="$gettext('Switch language')">
                #if $cur_flag
                <img class="lang-flag" src="static/img/flags/${cur_flag}.svg" alt="" width="18" height="14">
                #end if
                <span class="lang-trigger-label">$vane_language_name($lang)</span>
                <svg class="lang-chevron" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" style="fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round"><path d="M6 9l6 6 6-6"></path></svg>
              </button>
              <ul class="lang-listbox" role="listbox" aria-label="$gettext('Switch language')" tabindex="-1" hidden>
                #for $lcode, $lsubdir in $Vane.Languages.items()
                #set $lname = $vane_language_name($lcode)
                #set $lflag = $vane_language_flag($lcode)
                #if $lcode == $lang
                <li role="option" class="lang-option" aria-selected="true" tabindex="0">
                #else
                #set $lseg = $lsubdir + '/' if $lsubdir else ''
                <li role="option" class="lang-option" aria-selected="false" tabindex="-1" data-href="${Vane.root_href}${lseg}index.html">
                #end if
                  #if $lflag
                  <img class="lang-flag" src="static/img/flags/${lflag}.svg" alt="" width="18" height="14">
                  #end if
                  <span>$lname</span>
                </li>
                #end for
              </ul>
            </div>
            <button class="icon-btn" data-vane-theme-toggle title="$gettext('Toggle theme')" aria-label="$gettext('Toggle theme')">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" style="fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
            </button>
          </div>
        </header>

        <div class="row-wrap">

          <section class="hero-card card">
            #set $is_day = $current.dateTime.raw >= $almanac.sun.rise.raw and $current.dateTime.raw <= $almanac.sun.set.raw
            #set $icon = $vane_condition_icon($current.radiation.raw, $current.maxSolarRad.raw, $current.rainRate.raw, $is_day)
            <div style="display:flex;align-items:center;justify-content:space-between;gap:12px">
              <span class="uppercase-label">$gettext("Current conditions")</span>
              <span style="display:flex;align-items:center;gap:8px;font-size:13px;color:var(--text-muted)">
                <img src="static/img/icons/${icon}.svg" width="28" height="28" alt="">
                #if $icon == "clear-day" or $icon == "clear-night"
                $gettext('Clear')
                #else if $icon == "partly-cloudy-day" or $icon == "partly-cloudy-night"
                $gettext('Partly cloudy')
                #else if $icon == "cloudy"
                $gettext('Cloudy')
                #else if $icon == "overcast"
                $gettext('Overcast')
                #else if $icon == "rain"
                $gettext('Rain')
                #end if
              </span>
            </div>
            #if $day.outTemp.has_data
            <div class="hero-value">
              <span class="num" data-live="outTemp">$current.outTemp.format(add_label=False, format_string="%.1f")</span>
              <span class="unit">&deg;</span>
            </div>
            <div class="hero-meta">
              <div><div class="k">$gettext("Feels like")</div><div class="v"><span data-live="appTemp">$current.appTemp.format(add_label=False, format_string="%.1f")</span>&deg;</div></div>
              <div><div class="k">$gettext("Max")</div><div class="v">$day.outTemp.max.format(add_label=False, format_string="%.1f")&deg; <span style="color:var(--text-muted);font-weight:400">$day.outTemp.maxtime.format("%H:%M")</span></div></div>
              <div><div class="k">$gettext("Min")</div><div class="v">$day.outTemp.min.format(add_label=False, format_string="%.1f")&deg; <span style="color:var(--text-muted);font-weight:400">$day.outTemp.mintime.format("%H:%M")</span></div></div>
              <div><div class="k">$gettext("Dew point")</div><div class="v">$current.dewpoint.format(add_label=False, format_string="%.1f")&deg;</div></div>
              #if $day.windchill.has_data
              <div><div class="k">$gettext("Wind chill")</div><div class="v">$current.windchill.format(add_label=False, format_string="%.1f")&deg;</div></div>
              #end if
              #if $day.heatindex.has_data
              <div><div class="k">$gettext("Heat index")</div><div class="v">$current.heatindex.format(add_label=False, format_string="%.1f")&deg;</div></div>
              #end if
            </div>
            #set $temps = [$r.outTemp.raw for $r in $span(hour_delta=24).records if $r.outTemp.raw is not None]
            #*
              Taller than the tile sparklines (110 vs 28-64px) — the
              hero-card's height is dictated by the tiles-grid next to it
              (3 rows of tiles), which leaves a lot of vertical room here;
              a bigger, more readable trend chart fills it with actual
              signal instead of blank space. A second, smaller UV-index
              chart below it (same "vertelt weinig" fix) uses the rest of
              that room instead of leaving it empty.
            *#
            #set $spark = $vane_sparkline_path($temps, 300, 110)
            #if $spark[0]
            <div style="display:flex;flex-direction:column;gap:6px">
              <svg viewBox="0 0 300 110" preserveAspectRatio="none" style="width:100%;height:110px;display:block;overflow:visible">
                <path d="$spark[1]" fill="var(--accent-primary)" opacity="0.18"></path>
                <path d="$spark[0]" style="fill:none;stroke:var(--accent-primary);stroke-width:2;vector-effect:non-scaling-stroke;stroke-linejoin:round"></path>
              </svg>
              <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--text-muted)">
                <span>$gettext("24 hours ago")</span>
                <span>$gettext("Updated") $current.dateTime.format("%H:%M:%S")</span>
              </div>
            </div>
            #end if
            #if $day.UV.has_data
            #set $uv_vals = [$r.UV.raw for $r in $span(hour_delta=24).records if $r.UV.raw is not None]
            #set $uv_spark = $vane_sparkline_path($uv_vals, 300, 60)
            #if $uv_spark[0]
            <div style="display:flex;flex-direction:column;gap:6px;margin-top:16px">
              <span class="uppercase-label">$gettext("UV index") &middot; $gettext("Last 24 hours")</span>
              <svg viewBox="0 0 300 60" preserveAspectRatio="none" style="width:100%;height:60px;display:block;overflow:visible">
                <path d="$uv_spark[1]" fill="var(--accent-wind)" opacity="0.18"></path>
                <path d="$uv_spark[0]" style="fill:none;stroke:var(--accent-wind);stroke-width:2;vector-effect:non-scaling-stroke;stroke-linejoin:round"></path>
              </svg>
            </div>
            #end if
            #end if
            #else
            <div class="empty-state">$gettext("Not enough data yet for this view")</div>
            #end if
          </section>

          <div class="tiles-grid">

            #if $day.outHumidity.has_data
            #*
              Fixed 0-100 scale (the gray track = full possible range).
              The blue band marks where TODAY's min-max sits within it
              (vane_gauge_range_band); the red tick marks the current
              value (vane_gauge_tick) — three pieces of information at
              once: absolute context, today's actual spread, and now.
            *#
            #set $hum_band = $vane_gauge_range_band($day.outHumidity.min.raw, $day.outHumidity.max.raw, 0, 100)
            #set $hum_gauge = $vane_gauge_tick($current.outHumidity.raw, 0, 100)
            <div class="tile">
              <span class="tile-label"><img class="tile-icon" width="28" height="28" src="static/img/icons/humidity.svg" alt="">$gettext("Humidity")</span>
              <div class="tile-value"><span class="num" data-live="outHumidity">$current.outHumidity.format(add_label=False, format_string="%.0f")</span><span class="unit">%</span></div>
              #* Empty placeholder sub-line — Luchtdruk/UV both have one
                 line of sub-text here (trend / radiation), and without a
                 matching reserved line here the gauge below started at a
                 different height in this tile than its row-mates. *#
              <span class="tile-sub">&nbsp;</span>
              <svg class="gauge-svg" viewBox="0 0 120 70">
                <path class="gauge-track" d="M10,60 A50,50 0 1,1 110,60"></path>
                <path class="gauge-band" d="$hum_band[0]"></path>
                <path class="gauge-tick" d="$hum_gauge[0]" stroke="var(--accent-wind)"></path>
              </svg>
              <div class="tile-range">
                <span>$gettext("Min") $day.outHumidity.min.format(add_label=False, format_string="%.0f")%</span>
                <span>$gettext("Max") $day.outHumidity.max.format(add_label=False, format_string="%.0f")%</span>
              </div>
            </div>
            #end if

            #if $day.barometer.has_data
            #*
              Fixed 950-1055 hPa scale (worldwide sea-level extremes) —
              same three-layer pattern as the humidity gauge: gray track
              = full context, blue band = today's min-max, red tick =
              current value.
            *#
            #set $baro_band = $vane_gauge_range_band($day.barometer.min.raw, $day.barometer.max.raw, 950, 1055)
            #set $baro_gauge = $vane_gauge_tick($current.barometer.raw, 950, 1055)
            <div class="tile">
              <span class="tile-label"><img class="tile-icon" width="28" height="28" src="static/img/icons/barometer.svg" alt="">$gettext("Pressure")</span>
              <div class="tile-value"><span class="num" data-live="barometer">$current.barometer.format(add_label=False, format_string="%.1f")</span><span class="unit">$unit.label.barometer</span></div>
              #set $ptrend = $trend.barometer.raw
              <span class="tile-sub">
                #if $ptrend is not None and $ptrend < -0.1
                &darr; $gettext("falling")
                #else if $ptrend is not None and $ptrend > 0.1
                &uarr; $gettext("rising")
                #else
                &rarr; $gettext("steady")
                #end if
              </span>
              <svg class="gauge-svg" viewBox="0 0 120 70">
                <path class="gauge-track" d="M10,60 A50,50 0 1,1 110,60"></path>
                <path class="gauge-band" d="$baro_band[0]"></path>
                <path class="gauge-tick" d="$baro_gauge[0]" stroke="var(--accent-wind)"></path>
              </svg>
              <div class="tile-range">
                <span>$gettext("Min") $day.barometer.min.format(add_label=False, format_string="%.1f")$unit.label.barometer</span>
                <span>$gettext("Max") $day.barometer.max.format(add_label=False, format_string="%.1f")$unit.label.barometer</span>
              </div>
            </div>
            #end if

            #if $day.UV.has_data
            #*
              Same three-layer gauge as humidity/pressure: fixed 0-11 gray
              track, blue band for today's min-max, red tick for the
              current value — plus a Min/Max text row, consistent with
              those two tiles.
            *#
            #set $uv_band = $vane_gauge_range_band($day.UV.min.raw, $day.UV.max.raw, 0, 11)
            #set $uv_gauge = $vane_gauge_tick($current.UV.raw, 0, 11)
            <div class="tile">
              <span class="tile-label"><img class="tile-icon" width="28" height="28" src="static/img/icons/uv-index.svg" alt="">$gettext("UV index")</span>
              <div class="tile-value"><span class="num" data-live="UV">$current.UV.format(add_label=False, format_string="%.0f")</span></div>
              #if $day.radiation.has_data
              <span class="tile-sub"><span data-live="radiation">$current.radiation.format(add_label=False, format_string="%.0f")</span> $unit.label.radiation</span>
              #end if
              <svg class="gauge-svg" viewBox="0 0 120 70">
                <path class="gauge-track" d="M10,60 A50,50 0 1,1 110,60"></path>
                <path class="gauge-band" d="$uv_band[0]"></path>
                <path class="gauge-tick" d="$uv_gauge[0]" stroke="var(--accent-wind)"></path>
              </svg>
              <div class="tile-range">
                <span>$gettext("Min") $day.UV.min.format(add_label=False, format_string="%.0f")</span>
                <span>$gettext("Max") $day.UV.max.format(add_label=False, format_string="%.0f")</span>
              </div>
            </div>
            #end if

            #if $day.windSpeed.has_data
            <div class="tile">
              <span class="tile-label"><img class="tile-icon" width="28" height="28" src="static/img/icons/wind.svg" alt="">$gettext("Wind")</span>
              <div class="tile-value">
                <span class="num" data-live="windSpeed">$current.windSpeed.format(add_label=False, format_string="%.0f")</span>
                <span class="unit">$unit.label.windSpeed</span>
              </div>
              <span class="tile-sub">
                #if $day.windDir.has_data
                <span data-live="windDirCompass">$current.windDir.ordinal_compass</span> &middot;
                #end if
                #if $day.windGust.has_data
                $gettext("gusts") <span data-live="windGust">$current.windGust.format(add_label=False, format_string="%.0f")</span>$unit.label.windSpeed
                #end if
              </span>
              <div class="tile-range">
                <span>$gettext("Min") $day.windSpeed.min.format(add_label=False, format_string="%.0f")$unit.label.windSpeed</span>
                <span>$gettext("Max") $day.windSpeed.max.format(add_label=False, format_string="%.0f")$unit.label.windSpeed</span>
              </div>
              #set $wind_vals = [$r.windSpeed.raw for $r in $span(hour_delta=24).records if $r.windSpeed.raw is not None]
              #*
                Kept at the default tile-sparkline height (28px) —
                auto-scaling the Y-axis to a small range (e.g. a calm
                0-8 km/u day) means a taller chart just visually amplifies
                minor noise into what looks like big swings, misleading
                rather than more informative.
              *#
              #set $wind_spark = $vane_sparkline_path($wind_vals, 120, 28)
              #if $wind_spark[0]
              <svg class="tile-spark" viewBox="0 0 120 28" preserveAspectRatio="none">
                <path d="$wind_spark[1]" fill="var(--accent-wind)" opacity="0.16"></path>
                <path d="$wind_spark[0]" style="fill:none;stroke:var(--accent-wind);stroke-width:1.5;vector-effect:non-scaling-stroke;stroke-linejoin:round"></path>
              </svg>
              #end if
            </div>
            #end if

            #if $day.rain.has_data
            <div class="tile">
              <span class="tile-label"><img class="tile-icon" width="28" height="28" src="static/img/icons/raindrops.svg" alt="">$gettext("Rain")</span>
              <div class="tile-value"><span class="num" style="color:var(--accent-storm)">$day.rain.sum.format(add_label=False, format_string="%.1f")</span><span class="unit">$unit.label.rain</span></div>
              <span class="tile-sub">$gettext("today").capitalize()</span>
              <div class="tile-stats-stacked">
                <div class="stat-row">
                  <span>$gettext("this month").capitalize()</span>
                  <span class="stat-val">$month.rain.sum.format(add_label=True, format_string="%.1f")</span>
                </div>
                <div class="stat-row">
                  <span>$gettext("this year").capitalize()</span>
                  <span class="stat-val">$year.rain.sum.format(add_label=True, format_string="%.0f")</span>
                </div>
              </div>
            </div>
            #end if

            #if $day.luminosity.has_data
            <div class="tile">
              <span class="tile-label"><img class="tile-icon" width="28" height="28" src="static/img/icons/clear-day.svg" alt="">$gettext("Luminosity")</span>
              <div class="tile-value"><span class="num" data-live="luminosity">$current.luminosity.format(add_label=False, format_string="%.0f")</span><span class="unit">$unit.label.luminosity</span></div>
            </div>
            #end if

            #if $day.ET.has_data and $day.ET.sum.raw
            <div class="tile">
              <span class="tile-label"><img class="tile-icon" width="28" height="28" src="static/img/icons/fog.svg" alt="">$gettext("Evapotranspiration")</span>
              <div class="tile-value"><span class="num">$day.ET.sum.format(add_label=False, format_string="%.2f")</span><span class="unit">$unit.label.ET</span></div>
              <span class="tile-sub">$gettext("today").capitalize()</span>
              <div class="tile-stats-stacked">
                <div class="stat-row">
                  <span>$gettext("this month").capitalize()</span>
                  <span class="stat-val">$month.ET.sum.format(add_label=True, format_string="%.2f")</span>
                </div>
                <div class="stat-row">
                  <span>$gettext("this year").capitalize()</span>
                  <span class="stat-val">$year.ET.sum.format(add_label=True, format_string="%.2f")</span>
                </div>
              </div>
            </div>
            #end if

            #if $day.cloudbase.has_data
            #set $cb_cur = $current.cloudbase.raw
            #set $cb_min = $day.cloudbase.min.raw
            #set $cb_max = $day.cloudbase.max.raw
            #set $cb_unit = $unit.label.cloudbase.strip()
            #set $is_feet = 'ft' in $cb_unit or 'foot' in $cb_unit
            #set $fog_threshold = 100 if $is_feet else 30
            #set $cur_is_fog = ($cb_cur is not None and $cb_cur <= $fog_threshold)
            #set $min_is_fog = ($cb_min is not None and $cb_min <= $fog_threshold)
            <div class="tile">
              <span class="tile-label">
                #if $cur_is_fog
                <img class="tile-icon" width="28" height="28" src="static/img/icons/fog.svg" alt="">
                #else
                <img class="tile-icon" width="28" height="28" src="static/img/icons/cloudy.svg" alt="">
                #end if
                $gettext("Cloud base")
              </span>
              <div class="tile-value">
                #if $cur_is_fog
                <span class="num" style="font-size:26px">$gettext("Fog")</span>
                #else
                <span class="num">$current.cloudbase.format(add_label=False, format_string="%.0f")</span><span class="unit">$unit.label.cloudbase</span>
                #end if
              </div>
              #if $cur_is_fog or ($cb_cur is not None and $cb_cur <= (300 if $is_feet else 100))
              <span class="tile-sub">$gettext("Very low cloud base")</span>
              #end if
              #if $cb_min is not None and $cb_max is not None and $cb_max > $cb_min and $cb_cur is not None
              #set $eff_min = $fog_threshold if $cb_min <= $fog_threshold else $cb_min
              #if $cb_max > $eff_min
              #set $cb_pct = max(0, min(100, 100.0 * ($cb_cur - $eff_min) / ($cb_max - $eff_min)))
              <div class="tile-bar"><span style="width:${cb_pct}%;background:var(--accent-primary)"></span></div>
              #end if
              #end if
              <div class="tile-range">
                <span>$gettext("Min") #if $min_is_fog#$gettext("Fog")#else#$day.cloudbase.min.format(add_label=False, format_string="%.0f")$unit.label.cloudbase#end if#</span>
                <span>$gettext("Max") $day.cloudbase.max.format(add_label=False, format_string="%.0f")$unit.label.cloudbase</span>
              </div>
            </div>
            #end if

            #set $sun_now = $current.dateTime.raw
            #set $sun_rise = $almanac.sun.rise.raw
            #set $sun_set = $almanac.sun.set.raw
            <div class="tile">
              <span class="tile-label"><img class="tile-icon" width="28" height="28" src="static/img/icons/sunrise.svg" alt="">$gettext("Sun")</span>
              <div class="tile-value" style="font-variant-numeric:tabular-nums">
                <span class="num" style="font-size:22px">$almanac.sun.rise.format("%H:%M")</span>
                <span class="unit">&rarr;</span>
                <span class="num" style="font-size:22px">$almanac.sun.set.format("%H:%M")</span>
              </div>
              #if $sun_now < $sun_rise
              #set $mins_to = int(($sun_rise - $sun_now) / 60)
              <span class="tile-sub">$gettext("Sunrise in") ${mins_to // 60}$gettext("h_short")${mins_to % 60}m</span>
              #else if $sun_now > $sun_set
              <span class="tile-sub">$gettext("Sun has set")</span>
              #else
              #set $sun_pct = max(0, min(100, 100.0 * ($sun_now - $sun_rise) / ($sun_set - $sun_rise)))
              <div class="tile-bar"><span style="width:${sun_pct}%;background:var(--accent-wind)"></span></div>
              #end if
            </div>

            #if $vane_lightning_mode == 'local' and $day.lightning_strike_count.has_data
            <div class="tile">
              <span class="tile-label"><img class="tile-icon" width="28" height="28" src="static/img/icons/thunderstorms.svg" alt="">$gettext("Lightning")</span>
              #if $day.lightning_strike_count.sum.raw
              <div class="tile-value"><span class="num" style="color:var(--accent-storm)">$day.lightning_strike_count.sum.format(add_label=False, format_string="%.0f")</span><span class="unit">$gettext("strikes / hour")</span></div>
              #if $day.lightning_distance.has_data
              <span class="tile-sub">&gt; $current.lightning_distance.raw km</span>
              #end if
              #else
              <div class="tile-value"><span class="num" style="color:var(--status-live);font-size:26px">0</span><span class="unit">$gettext("strikes / hour")</span></div>
              <span class="tile-sub">$gettext("No activity in range")</span>
              <div class="tile-status-badge"><span class="live-dot" style="background:var(--status-live)"></span> $gettext("OK")</div>
              #end if
            </div>
            #elif $vane_lightning_mode == 'api' and $vane_lightning_api
            <div class="tile">
              <span class="tile-label"><img class="tile-icon" width="28" height="28" src="static/img/icons/thunderstorms.svg" alt="">$gettext("Lightning")</span>
              #if $vane_lightning_api.strikes
              <div class="tile-value"><span class="num" style="color:var(--accent-storm)">$vane_lightning_api.strikes</span><span class="unit">$gettext("strikes / hour")</span></div>
              #if $vane_lightning_api.avg_distance_km is not None
              <span class="tile-sub">&gt; $vane_lightning_api.avg_distance_km km</span>
              #end if
              #else
              <div class="tile-value"><span class="num" style="color:var(--status-live);font-size:26px">0</span><span class="unit">$gettext("strikes / hour")</span></div>
              <span class="tile-sub">$gettext("No activity in range")</span>
              <div class="tile-status-badge"><span class="live-dot" style="background:var(--status-live)"></span> $gettext("OK")</div>
              #end if
            </div>
            #end if

          </div>
        </div>

        #*
          Compact wind rose/rain calendar — reuses the Archive page's
          $vane_windrose (already computed per page generation, no extra
          query) and $vane_rain_color/.cal-grid CSS. $vane_windrose here is
          all-time (same [[ToDate]] timespan as this page, see skin.conf
          [CheetahGenerator]); the rain calendar is deliberately limited to
          the last 7 days (instead of the whole calendar month on Archive)
          to stay compact next to the tile row above.
        *#
        #if $vane_windrose.has_data or $day.rain.has_data
        <div class="row-wrap">
          #if $vane_windrose.has_data
          <section class="card" style="flex:1 1 260px;min-width:0;display:flex;flex-direction:column;align-items:center;gap:6px">
            <span class="uppercase-label" style="align-self:flex-start">$gettext("Wind") &middot; $gettext("Direction")</span>
            <svg class="windrose-svg" viewBox="-18 -18 336 336">
              <circle class="windrose-ring" cx="150" cy="150" r="125"></circle>
              <circle class="windrose-ring" cx="150" cy="150" r="83.3"></circle>
              <circle class="windrose-ring" cx="150" cy="150" r="41.6"></circle>
              #for $sector in $vane_windrose.sectors
              #if $sector.freq_pct > 0
              #set $tt = "%s — %s%% · %s %s" % ($sector.label, $round($sector.freq_pct, 1), $round($sector.avg_speed, 1), $unit.label.windSpeed)
              <path d="$sector.path_d" fill="var(--accent-primary)" opacity="0.88" data-tooltip="$tt"></path>
              #end if
              #end for
              #for $lp in $vane_windrose.label_points
              <text class="windrose-label" x="$lp.x" y="$lp.y">$lp.label</text>
              <text class="windrose-label-value" x="$lp.x" y="$lp.value_y">$lp.freq_pct%</text>
              #end for
            </svg>
            <span class="tile-sub">$gettext("Calm"): $round($vane_windrose.calm_pct, 1)%</span>
          </section>
          #end if
          #if $vane_wind_vector.has_data
          <section class="card" style="flex:1 1 260px;min-width:0;display:flex;flex-direction:column;align-items:center;gap:6px">
            <span class="uppercase-label" style="align-self:flex-start">$gettext("Wind") &middot; $gettext("Vector")</span>
            <svg class="windrose-svg" viewBox="-18 -18 336 336">
              <circle class="windrose-ring" cx="150" cy="150" r="125"></circle>
              <circle class="windrose-ring" cx="150" cy="150" r="83.3"></circle>
              <circle class="windrose-ring" cx="150" cy="150" r="41.6"></circle>
              #for $lp in $vane_wind_vector.label_points
              <text class="windrose-label" x="$lp.x" y="$lp.y">$lp.label</text>
              <text class="windrose-label-value" x="$lp.x" y="$lp.value_y">$lp.speed/$lp.gust</text>
              #end for
              <polygon class="windvector-polygon" points="$vane_wind_vector.gust_points" fill="var(--accent-wind)" stroke="var(--accent-wind)"></polygon>
              <polygon class="windvector-polygon" points="$vane_wind_vector.speed_points" fill="var(--accent-primary)" stroke="var(--accent-primary)"></polygon>
              #for $m in $vane_wind_vector.markers
              #set $mtt = "%s — %s: %s %s · %s: %s %s" % ($m.label, $gettext("Wind speed"), $m.speed, $unit.label.windSpeed, $gettext("Gusts"), $m.gust, $unit.label.windSpeed)
              <circle class="windvector-marker" cx="$m.speed_x" cy="$m.speed_y" r="4" fill="var(--accent-primary)" data-tooltip="$mtt"></circle>
              <circle class="windvector-marker" cx="$m.gust_x" cy="$m.gust_y" r="4" fill="var(--accent-wind)" data-tooltip="$mtt"></circle>
              #end for
            </svg>
            <div class="windvector-legend">
              <span><span class="dot" style="background:var(--accent-primary)"></span>$gettext("Wind speed")</span>
              <span><span class="dot" style="background:var(--accent-wind)"></span>$gettext("Gusts")</span>
            </div>
            <span class="tile-sub">$gettext("Max"): $vane_wind_vector.scale_max $unit.label.windSpeed</span>
          </section>
          #end if
          #if $day.rain.has_data or $year.outTemp.has_data
          #*
            One 7-column bar chart, bar + day-number stacked per column —
            replaces the earlier separate "colored day cells" grid plus a
            disconnected bar row below it, which read as two unrelated
            widgets stacked with a gap, not one chart. Bar height is
            relative to this week's own max, not a fixed scale (a 2mm week
            shouldn't look identical to a 20mm week).
          *#
          #set $week_rains = [($d.rain.sum.raw or 0) for $d in $span(day_delta=6).days]
          #set $week_max = max($week_rains)
          #*
            Rain-week bars and yearly records merged into one card (each
            still individually gated by its own #if) — as two separate
            cards they each had visible leftover space; side by side they
            fill one card's width and height properly.
          *#
          <section class="card" style="flex:1 1 260px;min-width:0">
            <div style="display:flex;flex-direction:column;justify-content:space-between;gap:18px;height:100%">
              #if $day.rain.has_data
              <div style="min-width:0">
                <span class="uppercase-label">$gettext("Rain") &middot; $gettext("Last 7 days")</span>
                <div class="rain-week-chart">
                  #for $d in $span(day_delta=6).days
                  #set $mm = $d.rain.sum.raw
                  #set $mm_val = $mm if $mm is not None else 0
                  #set $bar_pct = min(100, $mm_val / $week_max * 100) if $week_max > 0 else 0
                  #set $bar_day_num = $d.dateTime.format('%d')
                  #set $bar_mm_display = $round($mm_val, 1)
                  #set $is_today = $d.dateTime.format("%Y-%m-%d") == $current.dateTime.format("%Y-%m-%d")
                  <div class="rain-week-col" title="$bar_day_num: $bar_mm_display $unit.label.rain">
                    <span class="rain-week-val#if $mm_val == 0# is-zero#end if#">$bar_mm_display</span>
                    <div class="rain-week-bar-wrap">
                      <div class="rain-week-bar" style="height:${bar_pct}%;background:$vane_rain_color($mm)"></div>
                    </div>
                    <span class="tile-sub#if $is_today# is-today#end if#">$bar_day_num</span>
                  </div>
                  #end for
                </div>
              </div>
              #end if
              #if $year.outTemp.has_data
              <div style="min-width:0">
                <span class="uppercase-label">$gettext("Records") &middot; $gettext("this year")</span>
                <div class="records-list">
                  <div class="records-row">
                    <span class="tile-sub">$gettext("Highest")</span>
                    <span class="r-val">$year.outTemp.max.format(add_label=False, format_string="%.1f")&deg;</span>
                    <span class="r-date">$year.outTemp.maxtime.format("%d-%m")</span>
                  </div>
                  <div class="records-row">
                    <span class="tile-sub">$gettext("Lowest")</span>
                    <span class="r-val">$year.outTemp.min.format(add_label=False, format_string="%.1f")&deg;</span>
                    <span class="r-date">$year.outTemp.mintime.format("%d-%m")</span>
                  </div>
                  #if $year.windGust.has_data
                  <div class="records-row">
                    <span class="tile-sub">$gettext("Gusts")</span>
                    <span class="r-val">$year.windGust.max.format(add_label=False, format_string="%.0f") $unit.label.windSpeed</span>
                    <span class="r-date">$year.windGust.maxtime.format("%d-%m")</span>
                  </div>
                  #end if
                </div>
              </div>
              #end if
            </div>
          </section>
          #end if
        </div>
        #end if

        #*
          Extra sensors (auto-discovery) moved to telemetry.html.tmpl —
          belongs with station status, not with current weather conditions.
        *#

        #include "footer.inc"

        #* Plugin slot (see THEME_PLAN.md "Personal integrations are a
           separate plugin"): [Vane][[Plugins]] dashboard_plugins in
           skin.conf lists names; vane_extras.py reads plugins/<name>.inc
           for each (silently skipped if missing) and hands back the raw
           HTML here — nothing shows unless a plugin is actually
           configured and its file exists. *#
        #if $vane_dashboard_plugins_html
        $vane_dashboard_plugins_html
        #end if

      </div>
    </div>
  </div>
</div>

#if $vane_mqtt_config_json
<script>window.VANE_MQTT = $vane_mqtt_config_json;</script>
<script src="static/js/vendor/mqtt.min.js"></script>
#end if
<script src="static/js/theme-toggle.js?v=$vane_version"></script>
<script src="static/js/lang-select.js?v=$vane_version"></script>
<script src="static/js/chart-tooltip.js?v=$vane_version"></script>
<script src="static/js/dashboard-live.js?v=$vane_version"></script>
</body>
</html>
